# Dropped from archiso's releng package list (see scripts/build-iso.sh).
# Limine is the only bootloader on the ISO. syslinux stays because mkarchiso
# needs it to run releng's boot modes, but build-iso.sh discards those files.
grub
refind
edk2-shell
memtest86+
memtest86+-efi
# Rescue/cloud tooling that a desktop live ISO doesn't need
clonezilla
cloud-init
