# Maintainer: codegod100
# Split package for the KDE projects in https://github.com/codegod100/kde

pkgbase=nandi-kde
pkgname=(nandi-flatkit-aurorae nandi-loop-eyes nandi-whitelist-tray)
pkgver=r0
pkgrel=1
arch=(x86_64)
url="https://github.com/codegod100/kde"
license=(MIT GPL-2.0-or-later)
makedepends=(
  git cmake ninja extra-cmake-modules
  qt6-base qt6-declarative
  libplasma kstatusnotifieritem kio kxmlgui kitemmodels kiconthemes
  ki18n kconfig kservice kwindowsystem kjobwidgets
)
# NANDI_KDE_REF pins a commit of the kde repo (default: latest main).
_kde_ref=${NANDI_KDE_REF:-}
source=("kde::git+https://github.com/codegod100/kde.git${_kde_ref:+#commit=$_kde_ref}")
sha256sums=(SKIP)

pkgver() {
  cd kde
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

build() {
  cmake -S kde/loop-eyes -B build-loop-eyes -G Ninja -DCMAKE_BUILD_TYPE=Release
  cmake --build build-loop-eyes

  cmake -S kde/tray -B build-tray -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build-tray
}

package_nandi-flatkit-aurorae() {
  pkgdesc="Flatkit Aurorae window decorations (light and dark) for KWin"
  arch=(any)
  license=(MIT)
  depends=(kwin)

  install -d "$pkgdir/usr/share/aurorae/themes"
  cp -r --no-preserve=ownership kde/aurorae/themes/Flatkit kde/aurorae/themes/Flatkit-Dark \
    "$pkgdir/usr/share/aurorae/themes/"
  install -Dm644 kde/aurorae/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_nandi-loop-eyes() {
  pkgdesc="Loop Eyes: a Plasma 6 panel companion whose eyes follow the cursor"
  license=(MIT)
  depends=(qt6-base qt6-declarative kwin plasma-workspace)

  local plasmoids="$pkgdir/usr/share/plasma/plasmoids"
  install -d "$plasmoids" "$pkgdir/usr/share/kwin/scripts"
  cp -r --no-preserve=ownership kde/loop-eyes/plasmoid "$plasmoids/org.loop.eyes"
  install -m755 build-loop-eyes/backend/libloopeyesbackend.so "$plasmoids/org.loop.eyes/contents/ui/backend/"
  cp -r --no-preserve=ownership kde/loop-eyes/panel "$plasmoids/org.loop.eyes.panel"
  cp -r --no-preserve=ownership kde/loop-eyes/kwin "$pkgdir/usr/share/kwin/scripts/org.loop.eyes.cursor"
  install -Dm644 kde/loop-eyes/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 kde/loop-eyes/LICENSE-AVATAR "$pkgdir/usr/share/licenses/$pkgname/LICENSE-AVATAR"
}

package_nandi-whitelist-tray() {
  pkgdesc="Plasma 6 system tray that keeps icons in the popup unless whitelisted"
  license=(GPL-2.0-or-later)
  depends=(
    qt6-base qt6-declarative libplasma kstatusnotifieritem kio kxmlgui
    kitemmodels kiconthemes ki18n kconfig kservice kwindowsystem kjobwidgets
  )

  DESTDIR="$pkgdir" cmake --install build-tray
}
